# Copy to .env and fill in. The API reads these; the web app never sees the TMDB key.

# TMDB — get a free key at https://www.themoviedb.org/settings/api
# The library uses the v4 Read Access Token (Bearer). A v3 API key also works; see packages/tmdb.
TMDB_ACCESS_TOKEN=

# Postgres. Defaults to the dev container from docker-compose.yml (host port 5433).
# Point this at your own Postgres instead if you'd rather not use Docker.
DATABASE_URL=postgresql://skyspecs:skyspecs@localhost:5433/skyspecs

# API
PORT=4000

# Web dev server proxies /api to this origin
VITE_API_URL=http://localhost:4000
