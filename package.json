{
  "name": "skyspecs",
  "version": "0.1.0",
  "private": true,
  "description": "Movie collection curator — SkySpecs take-home",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:setup": "pnpm --filter @skyspecs/api db:setup",
    "bootstrap": "cp -n .env.example .env 2>/dev/null; docker compose up -d --wait && pnpm db:setup",
    "start": "pnpm run bootstrap && pnpm dev",
    "dev": "pnpm --recursive --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "test:coverage": "pnpm --recursive test:coverage",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  }
}
